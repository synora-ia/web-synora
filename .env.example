# Copia este archivo como .env.local (en local) o pon estas variables en el
# alojamiento (Vercel → Settings → Environment Variables).

# Webhook de n8n que recibe el formulario de /contacto. Sin él, el formulario
# responde «aún no está conectado» y enseña el correo: no se pierde nada.
# Recibe: nombre, apellidos, telefono, email, consulta (como el de synora.es)
# y además empresa, interes, origen y fecha.
CONTACTO_WEBHOOK_URL=

# Opcional. Si lo pones, se manda en la cabecera X-Synora-Secreto y el
# workflow puede rechazar lo que no venga de la web.
CONTACTO_WEBHOOK_SECRETO=
